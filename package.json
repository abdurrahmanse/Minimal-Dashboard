{
  "name": "minimal-dashboard",
  "version": "3.0.0",
  "packageManager": "npm@11.19.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0"
    }
  },
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-ts-eslint.js",
    "build": "turbo run build",
    "dev": "kill-port 3000 3001 3002 5173 5174 8080 8081 && turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "prettier": "3.9.6",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2",
    "eslint": "^10.10.0"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
